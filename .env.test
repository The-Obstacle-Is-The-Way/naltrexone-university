# Test environment variables
# Used by integration tests (loaded via tests/integration/setup.ts)
# This file is committed - it contains NO secrets

# Database is deliberately absent. Supported wrappers inject the per-clone
# target, and CI opts into its service target explicitly. Raw Vitest invocation
# fails closed instead of guessing which local database belongs to this clone.

# App URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Skip Clerk in tests (no real keys needed for integration tests)
NEXT_PUBLIC_SKIP_CLERK=true

# Dummy values for env validation (integration tests don't use these)
CLERK_SECRET_KEY=sk_test_dummy
CLERK_WEBHOOK_SIGNING_SECRET=whsec_dummy
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_SECRET_KEY=sk_test_dummy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_dummy_monthly
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_dummy_annual

# Optional observability keys (left blank intentionally in test env)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cron secret (route-level check uses this when cron route tests construct container env)
CRON_SECRET=cron_test_dummy
