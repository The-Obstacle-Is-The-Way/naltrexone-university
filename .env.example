# Naltrexone University - Environment Variables
# Copy this to .env.local (recommended) or .env and fill in your values
# See /docs/specs/master_spec.md Section 10 for full documentation

# =============================================================================
# DATABASE (Neon Postgres)
# =============================================================================
DATABASE_URL=postgresql://***

# =============================================================================
# CLERK (Authentication) - Get from https://dashboard.clerk.com
# =============================================================================
CLERK_SECRET_KEY=sk_test_***
# Webhook signing secret (Dashboard → Webhooks → Endpoint → Signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_***
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_***
# Set to 'true' to skip ClerkProvider during build (CI without real keys).
# Forbidden on Vercel production deploys (`VERCEL_ENV=production`).
# NEXT_PUBLIC_SKIP_CLERK=true

# =============================================================================
# STRIPE (Payments) - Get from https://dashboard.stripe.com/test/apikeys
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
# Dedicated HMAC key for trial-consent state. Generate with:
# openssl rand -hex 32
# Leave unset to keep the trial add-card consent flow fail-closed.
# CONSENT_STATE_SECRET=64_hex_characters
# Optional. Set on preview/test webhook deployments to skip explicit E2E
# subscription events owned by a different E2E environment.
# STRIPE_WEBHOOK_E2E_OWNER=vercel-dev-preview

# Stripe Price IDs - Create products at https://dashboard.stripe.com/test/products
# Pro Annual: $199/year
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_***
# Pro Monthly: $29/month
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_***

# =============================================================================
# RESEND (Transactional email) - Optional
# =============================================================================
# Leave unset to keep renewal-notice deliveries queued without a provider call.
# RESEND_API_KEY=re_***

# =============================================================================
# SENTRY (Error Tracking) - Get DSN from https://sentry.io → Project → Client Keys
# =============================================================================
# Optional: leave blank to disable Sentry telemetry.
# Production runtime emits a startup warning when both DSNs are unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# E2E (Playwright + Clerk)
# =============================================================================
# Used only by authenticated Playwright tests.
# E2E subscription seeding and paid Checkout also use DATABASE_URL,
# STRIPE_SECRET_KEY, CLERK_SECRET_KEY, and both Stripe Price IDs from above.
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
# Required when running E2E subscription seeding with real Stripe credentials.
E2E_STRIPE_OWNER=local-dev

# =============================================================================
# CRON / JOBS (Required in production runtime)
# =============================================================================
# Required on Vercel production deploys (`VERCEL_ENV=production`).
# Development, CI, and preview runtimes may omit this.
CRON_SECRET=changeme
