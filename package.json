{
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:coverage": "vitest run --config vitest.browser.config.ts --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx scripts/run-local-integration.ts",
    "test:integration:coverage": "tsx scripts/run-local-integration.ts --coverage",
    "test:e2e": "tsx scripts/run-local-e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "export:feedback": "tsx scripts/export-question-feedback.ts",
    "db:test:up": "tsx scripts/run-local-test-db.ts up",
    "db:test:down": "tsx scripts/run-local-test-db.ts down",
    "db:test:reset": "tsx scripts/run-local-test-db.ts reset",
    "local:test:target": "tsx scripts/resolve-local-test-target.ts",
    "content:import:drafts": "tsx scripts/import-draft-questions.ts",
    "db:seed:all": "bash scripts/seed-all-environments.sh"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": [
      "sh scripts/check-file-size.sh"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@clerk/ui": "^1.13.1",
    "@sentry/nextjs": "^10.53.1",
    "@tailwindcss/postcss": "4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pino": "^10.3.0",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@clerk/testing": "^2.0.33",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "tsx": "^4.20.5",
    "vite": "8.0.16",
    "vitest": "^4.1.7",
    "vitest-browser-react": "^2.2.0"
  }
}
