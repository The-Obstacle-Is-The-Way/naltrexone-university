{
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/deploy/check-server-action-manifest.ts",
    "start": "next start",
    "prepare": "husky",
    "lint": "biome check . --error-on-warnings && pnpm lint:doubles",
    "lint:ci": "biome ci . --error-on-warnings",
    "lint:doubles": "tsx tests/test-double-fidelity-live-scan.ts",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:browser:coverage": "vitest run --config vitest.browser.config.mts --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx scripts/test-lanes/run-local-integration.ts",
    "test:integration:coverage": "tsx scripts/test-lanes/run-local-integration.ts --coverage",
    "test:stripe-provider": "tsx scripts/test-lanes/run-stripe-provider-contracts.ts",
    "quality:crap": "tsx scripts/quality/crap-report.ts",
    "test:mutation": "stryker run",
    "test:e2e": "tsx scripts/test-lanes/run-local-e2e.ts --project=chromium --project=mobile-smoke",
    "test:e2e:stripe-hosted": "tsx scripts/test-lanes/run-local-e2e.ts --project=stripe-hosted",
    "db:generate": "tsx scripts/database/db-generate.ts",
    "db:migrate": "tsx scripts/database/db-migrate.ts",
    "db:seed": "tsx scripts/database/db-seed.ts",
    "db:studio": "tsx scripts/database/db-studio.ts",
    "export:feedback": "tsx scripts/feedback/export-question-feedback.ts",
    "notice:requeue": "tsx scripts/operations/requeue-renewal-notice.ts",
    "db:test:up": "tsx scripts/test-lanes/run-local-test-db.ts up",
    "db:test:down": "tsx scripts/test-lanes/run-local-test-db.ts down",
    "db:test:reset": "tsx scripts/test-lanes/run-local-test-db.ts reset",
    "local:test:target": "tsx scripts/test-lanes/resolve-local-test-target.ts",
    "content:import:drafts": "tsx scripts/import-draft-questions.ts",
    "db:seed:all": "tsx scripts/seed-all-environments.ts",
    "db:seed:prod": "tsx scripts/seed-production.ts",
    "pr:merge-reviewed": "tsx scripts/review/merge-reviewed-pr.ts",
    "pr:verify-promotion": "tsx scripts/review/verify-promotion.ts",
    "record:next": "tsx scripts/records/next-record-id.ts",
    "content:release:bootstrap": "tsx scripts/content-release/bootstrap-release.ts",
    "content:release:stage": "tsx scripts/content-release/stage-release.ts",
    "content:release:activate": "tsx scripts/content-release/activate-release.ts",
    "content:hold": "tsx scripts/content-release/hold-questions.ts",
    "content:keys:compare": "tsx scripts/content-release/compare-live-keys.ts",
    "content:census:key-returns": "tsx scripts/content-release/census-key-returns.ts",
    "content:census:normalization": "tsx scripts/content-release/census-normalization.ts",
    "content:withdraw": "tsx scripts/seed/withdraw-questions.ts",
    "db:verify-ledger": "tsx scripts/database/verify-migration-ledger.ts",
    "docs:audit": "tsx scripts/records/documentation-archive.ts",
    "secret:check-header": "tsx scripts/deploy/validate-header-safe-secret.ts",
    "deps:verify-union": "tsx scripts/dependencies/verify-lockfile-union.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "@clerk/nextjs": "^7.9.10",
    "@clerk/ui": "^1.38.1",
    "@noble/hashes": "2.4.0",
    "@sentry/nextjs": "^11.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@typescript/typescript6": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.0",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "6.34.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tinyglobby": "^0.2.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@clerk/testing": "^2.2.42",
    "@playwright/test": "^1.64.1",
    "@stripe/cli": "1.54.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "^30.0.1",
    "lint-staged": "~17.5.1",
    "tsx": "^4.20.5",
    "vite": "8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.2.0",
    "yaml": "2.9.1"
  }
}
