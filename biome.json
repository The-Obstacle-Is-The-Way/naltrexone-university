{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "!**/node_modules",
      "!**/.next",
      "!**/db/migrations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@sentry/nextjs": "Use the typed server-tracing boundary instead of importing the SDK directly."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/**/*.tsx",
        "components/**/*.tsx",
        "!components/ui/**",
        "!components/mobile-nav.tsx",
        "!**/*.test.tsx",
        "!**/*.browser.spec.tsx",
        "!**/*test-helpers.tsx",
        "!**/*.probes.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "Use the design-system Button. Raw buttons are restricted to primitives and documented Pattern Registry exceptions."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/adapters/shared/server-tracing.ts",
        "instrumentation.ts",
        "sentry.client.config.ts",
        "lib/report-client-error.ts",
        "vitest.browser.setup.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.browser.spec.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 800
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
