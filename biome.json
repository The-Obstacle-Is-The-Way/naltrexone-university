{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "!**/node_modules",
      "!**/.next",
      "!**/db/migrations"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@sentry/nextjs": "Use the typed server-tracing boundary instead of importing the SDK directly."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/domain/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.fixtures.ts",
        "!**/*.probes.tsx",
        "!**/*.setup.ts",
        "!**/*test-helpers.ts",
        "!**/*test-helpers.tsx",
        "!src/**/test-helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./**", "!../**"],
                    "message": "Domain code uses only relative domain imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/application/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.fixtures.ts",
        "!**/*.probes.tsx",
        "!**/*.setup.ts",
        "!**/*test-helpers.ts",
        "!**/*test-helpers.tsx",
        "!src/**/test-helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../**",
                      "!@/**",
                      "@/src/adapters/**",
                      "@/app/**",
                      "@/components/**",
                      "@/lib/**",
                      "@/db",
                      "@/db/**"
                    ],
                    "message": "Application code must not import outer-layer or package code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/adapters/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/*.fixtures.ts",
        "!**/*.probes.tsx",
        "!**/*.setup.ts",
        "!**/*test-helpers.ts",
        "!**/*test-helpers.tsx",
        "!src/**/test-helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/components/**", "@sentry/nextjs"],
                    "message": "Adapters must not import app or component code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "db/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "scripts/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "!app/(app)/app/billing/page.manage-billing.test.tsx",
        "!app/(app)/app/practice/\\[sessionId\\]/components/post-exam-review-view.fixtures.ts",
        "!app/(app)/app/practice/\\[sessionId\\]/hooks/practice-session-page-model.browser.fixtures.ts",
        "!app/(app)/app/practice/\\[sessionId\\]/hooks/practice-session-page-model.browser.probes.tsx",
        "!app/(app)/app/practice/\\[sessionId\\]/hooks/practice-session-page-model.browser.setup.ts",
        "!app/(app)/app/practice/\\[sessionId\\]/hooks/use-practice-session-exam-results-continuity.fixtures.ts",
        "!app/(app)/app/questions/\\[slug\\]/hooks/question-page-model.browser.fixtures.ts",
        "!lib/container.skip-clerk.test.ts",
        "!tests/e2e/global.setup.ts",
        "!tests/integration/actions.stripe.integration.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"],
                "requireAscii": false,
                "match": "([^.]+)[.]((?:(?:browser[.]spec|integration[.]test|test|spec|e2e)[.])?tsx?)"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/**/*.tsx",
        "components/**/*.tsx",
        "!components/ui/**",
        "!components/mobile-nav.tsx",
        "!**/*.test.tsx",
        "!**/*.browser.spec.tsx",
        "!**/*test-helpers.tsx",
        "!**/*.probes.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "Use the design-system Button. Raw buttons are restricted to primitives and documented Pattern Registry exceptions."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/adapters/shared/server-tracing.ts",
        "instrumentation.ts",
        "sentry.client.config.ts",
        "lib/report-client-error.ts",
        "vitest.browser.setup.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.browser.spec.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 800
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
